{
  "version": 2,
  "active": "nagato",
  "window": {
    "target_character_logical_height": 267,
    "size_presets": [
      180,
      267,
      360
    ],
    "always_on_top": true,
    "click_through_transparent": true,
    "remember_position": true
  },
  "behaviour": {
    "roam": {
      "enabled": false,
      "speed_px_s": 70,
      "walk_fps": 5.5,
      "pause_s": [
        4,
        13
      ],
      "edge_margin": 24,
      "chase_cursor_chance": 0.25,
      "resume_after_drag_s": 6.0,
      "bob": 0.014
    },
    "drag": {
      "edge_snap_px": 90
    },
    "transition_seconds": 0.15,
    "chat": {
      "open_on": "double_click",
      "reaction_on": "single_click",
      "pause_roam_while_typing": true
    },
    "proactive": {
      "enabled": true,
      "mode": "model",
      "every_minutes": [
        6,
        22
      ],
      "backoff_factor": 1.6,
      "min_minutes": 4,
      "max_minutes": 45,
      "speak_chance": 0.6,
      "actions": [
        "sleep",
        "cling_left",
        "cling_right",
        "walk",
        "blink"
      ],
      "speech_seconds": 7
    },
    "face_overlay_bodies": [],
    "walk_speed_px_s": 180
  },
  "characters": {
    "nagato": {
      "canvas": [
        1024,
        1024
      ],
