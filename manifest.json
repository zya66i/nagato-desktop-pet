        "sleep2": "assets/parts/sleep2.png",
        "sleep_quilt": "assets/parts/sleep_quilt.png",
        "cling_l": "assets/parts/cling_l.png",
        "cling_r": "assets/parts/cling_r.png",
        "lift": "assets/parts/lift.png",
        "idle_pose": "assets/parts/idle_pose.png",
        "walkup_a": "assets/parts/walkup_a.png",
        "walkup_b": "assets/parts/walkup_b.png",
        "walkdown_a": "assets/parts/walkdown_a.png",
        "walkdown_b": "assets/parts/walkdown_b.png",
        "blink": "assets/parts/face_closed.png",
        "drag": "assets/parts/lift.png",
        "cling_left": "assets/parts/cling_l.png",
        "cling_right": "assets/parts/cling_r.png",
        "daze": "assets/parts/idle_pose.png"
      },
      "motions": {
        "breathe": {
          "kind": "breathe",
          "period": 3.4,
          "amount": 0.014
        },
        "click_pop": {
          "kind": "pop",
          "period": 0.42,
          "amount": 0.075,
          "decay": 3.4
        },
        "drag_tilt": {
          "kind": "tilt",
          "max_deg": 10.0,
          "stretch": 0.035,
          "smooth": 0.22,
          "dangle_deg": 2.6,
          "dangle_period": 1.7
        },
        "sleep_breathe": {
          "kind": "breathe",
          "period": 5.2,
          "amount": 0.008
        }
      },
      "actions": {
        "idle": {
          "motions": [
            "breathe"
          ]
        },
        "walk": {
          "frames_right": [
            "walk_r3",
            "walk_r1",
            "walk_r3",
            "walk_s2"
          ],
          "frames_left": [
            "walk_l3",
            "walk_l1",
            "walk_l3",
            "walk_s2_l"
          ],
          "fps": 5.0,
          "distance_px": [
            150,
            350
          ],
          "motions": [
            "breathe"
          ]
        },
        "blink": {
          "overlay": "eyes_closed",
          "duration": 0.17,
          "every": [
            3.5,
            8.0
          ]
        },
        "click": {
          "on": "single_click",
          "duration": 0.75,
          "overlay": "face_surprised",
          "overlay_duration": 0.7,
          "motions": [
            "click_pop"
          ]
        },
        "drag": {
          "on": "dragging",
          "body": "lift",
          "motions": [
            "drag_tilt"
          ]
        },
        "sleep": {
          "frames": [
            "sleep_sit",
            "sleep2"
          ],
          "frames_quilt": [
            "sleep_sit",
            "sleep_quilt"
          ],
          "fps": 0.8,
          "loop": false,
          "duration": 1800,
          "motions": [
            "sleep_breathe"
          ]
        },
        "cling_left": {
          "body": "cling_l",
          "duration": 3600,
          "window_edge": "left",
          "return_with": "walk",
          "motions": []
        },
        "cling_right": {
          "body": "cling_r",
          "duration": 3600,
          "window_edge": "right",
          "return_with": "walk",
          "motions": []
        },
        "daze": {
          "body": "idle_pose",
          "duration": 180.0,
          "motions": [
            "breathe"
          ]
        },
        "go_up": {
          "duration": 2.0,
          "motions": [
            "breathe"
          ],
          "frames": [
            "walkup_a",
            "walkup_b"
          ],
          "fps": 5.0
        },
        "go_down": {
          "duration": 2.0,
          "motions": [
            "breathe"
          ],
          "frames": [
            "walkdown_a",
            "walkdown_b"
          ],
          "fps": 5.0
        },
        "go_left": {
          "duration": 2.0,
          "motions": [
            "breathe"
          ]
        },
        "go_right": {
          "duration": 2.0,
          "motions": [
            "breathe"
          ]
        }
      }
    }
  },
